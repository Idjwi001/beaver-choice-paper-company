%% Beaver's Choice Paper Company - multi-agent workflow (pydantic-ai, 4 agents)
flowchart TB
    CUST(["Customer request (text + request date)"])
    REPLY(["Customer reply: items, prices, discount rationale,<br/>delivery dates, reasons for unfulfilled items"])

    subgraph ORCH["1 · ORCHESTRATOR AGENT — customer service lead: parses request, delegates, writes reply"]
        direction LR
        T_PARSE["parse_request<br/><i>Extracts items, quantities (reams→sheets), deadline</i><br/>helper: none (regex + catalog rules)"]
        T_DINV["delegate_to_inventory_agent"]
        T_DQUO["delegate_to_quoting_agent<br/><i>only if ≥1 line is fulfillable</i>"]
        T_DSAL["delegate_to_sales_agent<br/><i>only if a quote exists</i>"]
        T_STAT["get_order_status<br/><i>Reads customer-safe order record</i>"]
        T_COMP["compose_customer_response<br/><i>Builds reply; hides cash, costs, margins, ids</i>"]
    end

    BB[("OrderContext blackboard (pydantic-ai deps)<br/>line items · status · reasons · quote · sale flag")]

    subgraph INV["2 · INVENTORY AGENT — stock checks & reorder decisions"]
        direction TB
        I1["get_inventory_snapshot<br/><i>All items in stock</i><br/>helper: get_all_inventory"]
        I2["check_stock_level<br/><i>Stock of one item</i><br/>helper: get_stock_level"]
        I3["check_supplier_delivery<br/><i>Supplier ETA for a quantity</i><br/>helper: get_supplier_delivery_date"]
        I4["assess_line_item<br/><i>Match catalog → stock → shortfall? → ETA ≤ deadline?<br/>→ cash ≥ reserve? ⇒ AVAILABLE / RESTOCK_REQUIRED / UNAVAILABLE</i><br/>helpers: get_stock_level, get_supplier_delivery_date, get_cash_balance"]
        I5["place_supplier_restock<br/><i>Buys shortfall + top-up to 2× min stock</i><br/>helpers: create_transaction('stock_orders'), get_cash_balance"]
    end

    subgraph QUO["3 · QUOTING AGENT — pricing & bulk discounts"]
        direction TB
        Q1["search_quote_history<br/><i>Comparable past quotes (event / product)</i><br/>helper: search_quote_history"]
        Q2["calculate_quote<br/><i>List price × qty; discount tiers:<br/>1k units 5% · 5k 10% · 20k 15%</i>"]
    end

    subgraph SAL["4 · SALES AGENT — financial check & order finalization"]
        direction TB
        S1["check_cash_balance<br/><i>Current cash</i><br/>helper: get_cash_balance"]
        S2["financial_health_check<br/><i>Run for orders ≥ $500</i><br/>helper: generate_financial_report"]
        S3["finalize_sale<br/><i>Re-checks stock, books discounted sale per line</i><br/>helpers: get_stock_level, create_transaction('sales')"]
    end

    DB[("SQLite munder_difflin.db<br/>transactions · inventory · quotes · quote_requests")]

    CUST -->|"1. request text"| T_PARSE
    T_DINV ==>|"2. delegate: lines + deadline"| INV
    INV -.->|"per-line status + reasons"| T_DINV
    T_DQUO ==>|"3. delegate: fulfillable items"| QUO
    QUO -.->|"subtotal, discount, total"| T_DQUO
    T_DSAL ==>|"4. delegate: quote + LARGE_ORDER flag"| SAL
    SAL -.->|"booking confirmation"| T_DSAL
    T_COMP -->|"5. final reply"| REPLY

    ORCH <-->|"shared order state"| BB
    INV <--> BB
    QUO <--> BB
    SAL <--> BB

    INV <-->|"stock / stock_orders"| DB
    QUO <-->|"quotes + quote_requests"| DB
    SAL <-->|"cash / sales / reports"| DB

    classDef agent fill:#eef4ff,stroke:#3a5bbf,stroke-width:2px,color:#111;
    classDef tool fill:#ffffff,stroke:#7a8599,color:#111;
    classDef store fill:#fff6e0,stroke:#b8860b,color:#111;
    classDef io fill:#e9f7ef,stroke:#2e8b57,color:#111;
    class ORCH,INV,QUO,SAL agent;
    class T_PARSE,T_DINV,T_DQUO,T_DSAL,T_STAT,T_COMP,I1,I2,I3,I4,I5,Q1,Q2,S1,S2,S3 tool;
    class BB,DB store;
    class CUST,REPLY io;
